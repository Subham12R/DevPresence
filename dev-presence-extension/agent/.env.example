# Optional remote API that receives forwarded presence snapshots.
# Leave this empty for personal, local-only use.
API_URL=

# Optional bearer token for your remote API.
API_KEY=

# Local agent port. Keep this in sync with the VS Code setting
# `devPresence.agentUrl` if you change it.
PORT=7337

# Optional custom database location. When omitted, the agent stores data in:
# macOS:   ~/Library/Application Support/dev-presence/presence.db
# Windows: ~/.dev-presence/presence.db
# Linux:   ~/.local/share/dev-presence/presence.db
# DEV_PRESENCE_DB_PATH=

# Advanced timing controls. The defaults are a good starting point.
# DEFAULT_IDLE_TIMEOUT_MS=300000
# DEFAULT_STALE_AFTER_MS=600000
# RECONCILE_INTERVAL_MS=15000
